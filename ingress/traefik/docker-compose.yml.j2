services:
  traefik:
    image: traefik:{{ traefik_version }}
    container_name: traefik
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    networks:
      - traefik
    ports:
      - "80:80"
      - "443:443"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      # Configure your email for LetsEncrypt
      - TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_EMAIL={{ traefik_acme_email }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/traefik.yml:ro
      - ./dynamic.yml:/dynamic.yml:ro
      - ./acme.json:/acme.json
{% if traefik_loki_enabled %}
    logging:
      driver: loki
      options:
        loki-url: "https://{{ loki_username }}:{{ loki_password }}@{{ traefik_loki_url | regex_replace('^https?://', '') }}"
        loki-retries: "{{ traefik_loki_retries }}"
        loki-batch-size: "{{ traefik_loki_batch_size }}"
        loki-external-labels: "job=traefik,host={{ inventory_hostname }},container={% raw %}{{.Name}}{% endraw %}"
        mode: non-blocking
        max-buffer-size: 4m
{% endif %}
    labels:
      # Enable Traefik for this container
      - "traefik.enable=true"

      # Dashboard
      - "traefik.http.routers.traefik-dashboard.rule=Host(`traefik.vps.kubespaces.cloud`)"
      - "traefik.http.routers.traefik-dashboard.entrypoints=websecure"
      - "traefik.http.routers.traefik-dashboard.tls=true"
      - "traefik.http.routers.traefik-dashboard.tls.certresolver=letsencrypt"
      - "traefik.http.routers.traefik-dashboard.service=api@internal"
      - "traefik.http.routers.traefik-dashboard.middlewares=dashboard-auth,fail2ban@file"

      # Basic auth for dashboard security
      - "traefik.http.middlewares.dashboard-auth.basicauth.users=admin:$$2y$$05$$ZV29JTIroQmmo/bRLamjB.zzZBO/sprB2qMCstsMTm3uQ.M9Tfipm"

networks:
  traefik:
    name: traefik
    driver: bridge
