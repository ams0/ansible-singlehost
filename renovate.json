{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "semanticCommits": "enabled",
  "separateMinorPatch": true,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "schedule": [
    "every weekend"
  ],
  "flux": {
    "managerFilePatterns": [
      "/gitops/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/gitops/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/gitops/apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Auto-merge patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Group all n8n updates",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "n8nio/n8n"
      ],
      "groupName": "n8n",
      "commitMessageTopic": "n8n"
    }
  ]
}
