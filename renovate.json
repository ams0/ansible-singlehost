{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "regexManagers": [
    {
      "fileMatch": ["n8n-helmrelease\\.yaml$"],
      "matchStrings": [
        "image:\\s*?tag:\\s*?(?<currentValue>.*?) # renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}