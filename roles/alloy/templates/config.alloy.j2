// Host-level Alloy config: ship systemd journal + selected /var/log files
// to the public Loki endpoint using HTTP basic auth.

// ----- Systemd journal -----
discovery.relabel "journal" {
  targets = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "hostname"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label  = "transport"
  }
}

loki.source.journal "journal" {
  format_as_json = false
  path           = "/var/log/journal"
  max_age        = "{{ alloy_journal_max_age }}"
  labels         = {
    job  = "systemd-journal",
    host = "{{ inventory_hostname }}",
  }
  relabel_rules  = discovery.relabel.journal.rules
  forward_to     = [loki.write.default.receiver]
}

// ----- Plain-text log files under /var/log -----
// Pass targets directly (skipping local.file_match) so explicit non-glob
// paths are honored without glob expansion.
loki.source.file "varlog" {
  targets = [
{% for f in alloy_log_files %}
    {__path__ = "{{ f.path }}", job = "{{ f.job }}", host = "{{ inventory_hostname }}"},
{% endfor %}
  ]
  forward_to = [loki.process.host_logs.receiver]
}

// Per-job line parsers. Captured fields land as structured metadata —
// queryable but not promoted to labels (which would explode cardinality
// for high-arity values like IPs).
loki.process "host_logs" {
  forward_to = [loki.write.default.receiver]

  // fail2ban: jail, action (Found/Ban/Unban), and source IP
  stage.match {
    selector = "{job=\"fail2ban\"}"

    stage.regex {
      expression = `INFO\s+\[(?P<jail>[^\]]+)\]\s+(?P<action>Found|Ban|Unban|Already banned|Restore Ban)(?:\s+(?P<ip>\d+\.\d+\.\d+\.\d+))?`
    }

    stage.structured_metadata {
      values = {
        ip     = "",
        action = "",
        jail   = "",
      }
    }
  }
}

// ----- Docker container logs -----
// Discover all running containers via the Docker API and tail their logs.
// Replaces the per-container loki-docker-driver (fragile across reboots and
// blocks shutdown when Loki is unreachable). Alloy buffers locally and never
// blocks the containers it reads from.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Container name (strip the leading "/") -> `container` label.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }

  // Drop Alloy's own logs to avoid a self-ingestion feedback loop.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?alloy"
    action        = "drop"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  labels        = {
    job  = "docker",
    host = "{{ inventory_hostname }}",
  }
  forward_to = [loki.write.default.receiver]
}

// ----- Loki write -----
loki.write "default" {
  endpoint {
    url = "{{ alloy_loki_url }}"
    basic_auth {
      username = "{{ loki_username }}"
      password = "{{ loki_password }}"
    }
  }
}
