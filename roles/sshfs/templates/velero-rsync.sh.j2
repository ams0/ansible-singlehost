#!/bin/bash
# Sync Velero backups to Mac Mini over SSH (Tailscale)
set -euo pipefail

REMOTE_USER="{{ sshfs_mounts[0].remote_user }}"
REMOTE_HOST="{{ sshfs_mounts[0].remote_host }}"
REMOTE_PATH="{{ sshfs_mounts[0].remote_path }}"
SSH_KEY="{{ sshfs_mounts[0].ssh_key }}"

echo "$(date -Iseconds) Starting Velero backup sync to ${REMOTE_HOST}"

rsync -az --delete \
  -e "ssh -i ${SSH_KEY} -o StrictHostKeyChecking=accept-new -o ConnectTimeout=30" \
  /var/velero-backups/ \
  "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PATH}/"

echo "$(date -Iseconds) Velero backup sync complete"
